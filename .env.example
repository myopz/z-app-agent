# Server
PORT=39000

# Public URL prefix for web (Vite base + React Router + /api|/preview proxy).
# mac.ittoolplus.cn 反代：https://mac.ittoolplus.cn/zapp/
# 设为 / 或留空表示挂在站点根路径。
PUBLIC_BASE_PATH=/zapp

# ---- LLM (OpenAI-compatible) ----
# Base URL must include the /v1 prefix used by the provider.
LLM_BASE_URL=https://xxx/api/openai/v1

# Model id (provider-specific). ittoolplus accepts "auto" for free failover.
LLM_MODEL=auto

# API key when required (OpenAI / DeepSeek / SiliconFlow / OpenRouter …).
# ittoolplus free endpoint usually needs no key — leave empty.
LLM_API_KEY=

# Also accepted aliases:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Request timeout (ms)
LLM_TIMEOUT_MS=90000

# Optional extra headers as JSON, e.g. OpenRouter:
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"z-app-agent"}

# Agent runtime
MAX_FIX_ATTEMPTS=3
PREVIEW_PORT_BASE=3900

# ---- Provider examples (uncomment one) ----
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# SiliconFlow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-oss-20b:free
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://localhost","X-Title":"z-app-agent"}
